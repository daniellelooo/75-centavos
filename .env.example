# Copia este archivo a .env.local y rellena los valores.
# Todo es opcional: sin estas variables el juego funciona igual y guarda en el navegador.

# Cuentas (Clerk). La publicable llega al navegador; la secreta solo a /api.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Base de datos (Neon Postgres) para guardar partidas y perfiles en la nube (/api).
DATABASE_URL=
